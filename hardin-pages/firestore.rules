// Paste this into Firebase console > Firestore Database > Rules > Publish.
// Replace PASTE_YOUR_ADMIN_UID_HERE with the User UID of your admin account
// (Authentication > Users tab). It's the same UID you used before.
//
// The subscribers rules are gone. If you still have a "subscribers" collection
// in Firestore, delete it in the Firebase console (see the notes that came with this update).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.uid == "dq1svskEn1SmaJQsB2AHugYjvis1";
    }

    // ---------- Posts ----------
    match /posts/{postId} {
      // Visitors only ever see published posts. Drafts stay private.
      allow read: if isAdmin() || resource.data.status == 'published';

      // Only you can create, edit or delete posts
      allow create, delete: if isAdmin();

      allow update: if isAdmin()

        // A visitor may add exactly +1 to the view count...
        || (resource.data.status == 'published'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.get('views', 0) + 1)

        // ...or plant / take back a seedling (+1 or -1, never below 0)
        || (resource.data.status == 'published'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions >= 0
            && (request.resource.data.reactions == resource.data.get('reactions', 0) + 1
                || request.resource.data.reactions == resource.data.get('reactions', 0) - 1));
    }

    // ---------- Folders (menus and breadcrumbs) ----------
    match /folders/{folderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Site visit counter ----------
    match /siteStats/{docId} {
      allow read: if true;

      allow create: if isAdmin()
                    || (docId == 'counter'
                        && request.resource.data.keys().hasOnly(['visits'])
                        && request.resource.data.visits == 1);

      allow update: if isAdmin()
                    || (docId == 'counter'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
                        && request.resource.data.visits == resource.data.visits + 1);

      allow delete: if isAdmin();
    }

    // ---------- Calendar events (notes and markers on dates) ----------
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Site settings ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
